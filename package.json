{
  "name": "@moba2d/content-dota",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:generate": "moba2d-generate-assets",
    "assets:check": "moba2d-generate-assets --check",
    "catalog:generate": "moba2d-generate-spell-catalog --tree=dota --root=.",
    "catalog:check": "moba2d-generate-spell-catalog --check --tree=dota --root=.",
    "core:check": "moba2d-check-core-link",
    "postinstall": "moba2d-check-core-link --warn-only",
    "prepare": "npm run assets:generate && npm run catalog:generate",
    "hooks:install": "git config core.hooksPath scripts/git-hooks",
    "typecheck": "tsc -p tsconfig.json",
    "check-unused": "moba2d-check-unused",
    "check-seams": "moba2d-check-seams ./spells",
    "test": "vitest run",
    "build": "npm run assets:generate && npm run catalog:generate && vite build && moba2d-write-manifest --name=\"Dota 2\"",
    "manifest:write": "moba2d-write-manifest --name=\"Dota 2\"",
    "serve": "moba2d-pack-serve",
    "verify": "npm run core:check && npm run art:check && npm run assets:check && npm run catalog:check && npm run typecheck && npm run check-unused && npm run check-seams && npm run build && npm test",
    "art:import": "node scripts/import-art.mjs",
    "art:check": "node scripts/import-art.mjs --check"
  },
  "devDependencies": {
    "@moba2d/core": "github:moba2d-game/core#main",
    "@types/node": "^22.20.1",
    "@types/p5": "^1.7.6",
    "sharp": "^0.35.3",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.1"
  }
}
