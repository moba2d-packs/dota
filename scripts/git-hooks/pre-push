#!/bin/sh
# Pre-push gate: `npm run verify` must pass before anything leaves this machine.
#
# Versioned here rather than living only in .git/hooks so a fresh clone gets it
# back with one command: `npm run hooks:install` (points core.hooksPath here).
#
# Escape hatches:
#   git push --no-verify           # skip once, on purpose
#   MOBA2D_SKIP_VERIFY=1 git push  # same, for scripts
#
# Verify runs against whichever @moba2d/core is installed. To build against
# the sibling checkout instead of the published one, link it first:
#   cd ../moba2d-core && npm run pack:link -- ../dota

[ "$MOBA2D_SKIP_VERIFY" = "1" ] && exit 0

# stdin: one "<local ref> <local sha> <remote ref> <remote sha>" line per ref.
# A push that only deletes remote refs (local sha all zeros) verifies nothing.
zero=0000000000000000000000000000000000000000
updates=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] || updates=1
done
[ "$updates" = "1" ] || exit 0


# The performance guard, before the long verify so a spell problem is reported
# in seconds rather than after a full build. It measures only the spell files
# this push adds; anything else and it exits immediately. Core is reached
# through node_modules when installed, or the sibling checkout when linked.
#   MOBA2D_PERF_GUARD_SKIP=1 git push   # bypass, on purpose
for guard in \
  "node_modules/@moba2d/core/scripts/perf-guard.mjs" \
  "../moba2d-core/scripts/perf-guard.mjs"
do
  if [ -f "$guard" ]; then
    node "$guard" --repo "$(pwd)" || exit 1
    break
  fi
done

echo "pre-push: running npm run verify (git push --no-verify skips this once)"
npm run verify && exit 0

echo ""
echo "pre-push: verify FAILED — push blocked."
echo "  skip once on purpose: git push --no-verify"
exit 1
